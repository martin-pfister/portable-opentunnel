# Rust build output
/target/
**/*.rs.bk

# ---------------------------------------------------------------- credentials
# State directories hold the SDK token, private key, certificate, and route.
# Never commit state. Keep your chosen --dir outside the checkout or
# ignore it explicitly; also guard the SDK profile against accidental staging.
sdk/default/

# ---------------------------------------------------------- build products
/.ci-out/
/dist/

# ------------------------------------------------------------- local config
.env
.env.*
!.env.example
# Developer-local agent/sandbox policy. Machine-specific; never committed.
/.opencode/sandbox.json

# ------------------------------------------------------- editors and OS noise
.DS_Store
.idea/
.vscode/
*.swp
